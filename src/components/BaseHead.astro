---
// 全局样式只在这里引入一次，所有页面通过 BaseHead 共享
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
	/** og:type，文章页传 article */
	type?: 'website' | 'article';
	/** 文章首次发表时间，用于 article:published_time */
	publishedTime?: Date;
	/** 404 等页面传 true */
	noindex?: boolean;
}

// Astro 6 起，build.format:'file' 时 pathname 会带上 index.html，
// 这里去掉，避免 canonical 指向 /index.html 造成重复 URL
const pathname = Astro.url.pathname.replace(/index\.html$/, '');
const canonicalURL = new URL(pathname, Astro.site);
const {
	title,
	description = SITE_DESCRIPTION,
	image,
	type = 'website',
	publishedTime,
	noindex = false,
} = Astro.props;

// 首页不加站点后缀，其余页面统一「标题 - 恒温箱」；已自带站点名的标题不重复拼接
const isHome = pathname === '/';
const fullTitle = isHome || title.includes(SITE_TITLE) ? title : `${title} - ${SITE_TITLE}`;
// 分享图可选：文章没指定封面时不输出 og:image，避免指向不存在的图片
const ogImage = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="128x128" href="/img/favicon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site ?? Astro.url)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f1219" media="(prefers-color-scheme: dark)" />

<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex,follow" />}

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
