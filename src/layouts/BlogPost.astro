---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { LAST_UPDATED } from '../consts';

interface Props {
	title: string;
	description?: string;
	date: Date;
	updated?: Date;
	image?: string;
}

const { title, description, date, updated, image } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type="article"
			publishedTime={date}
		/>
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
			}
			.prose {
				max-width: var(--measure);
				margin: 0 auto;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2.5em;
				padding-bottom: 1.75em;
				border-bottom: 1px solid rgb(var(--gray-light));
				line-height: 1.2;
			}
			.title h1 {
				margin: 0;
				font-size: 1.9em;
			}
			.date {
				margin-bottom: 0.7em;
				color: rgb(var(--gray));
				font-size: 0.85em;
				letter-spacing: 0.02em;
			}
			.last-updated-on {
				margin-top: 0.2em;
				opacity: 0.75;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={date} />
							{updated && (
								<div class="last-updated-on">{LAST_UPDATED} <FormattedDate date={updated} /></div>
							)}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
