---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { LAST_UPDATED } from '../consts';

interface Props {
	title: string;
	description?: string;
	date: Date;
	updated?: Date;
	image?: string;
}

const { title, description, date, updated, image } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type="article"
			publishedTime={date}
		/>
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
			}
			.post {
				max-width: var(--measure);
				margin: 0 auto;
				color: rgb(var(--gray-dark));
			}
			/* 标题区：日期在上，标题在下，用一条细线收口 */
			.post-head {
				margin-bottom: 2.5em;
				padding-bottom: 1.75em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0 0.75em;
				margin: 0 0 0.7em;
				color: rgb(var(--gray));
				font-size: 0.85em;
				letter-spacing: 0.02em;
			}
			.post-meta .updated {
				opacity: 0.75;
			}
			.post-title {
				margin: 0;
				font-size: 1.9em;
				line-height: 1.2;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<header class="post-head">
					<p class="post-meta">
						<FormattedDate date={date} />
						{updated && (
							<span class="updated">{LAST_UPDATED} <FormattedDate date={updated} /></span>
						)}
					</p>
					<h1 class="post-title">{title}</h1>
				</header>
				<div class="post-body">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
