---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { ALL_POSTS, SITE_DESCRIPTION, SITE_DESCRIPTION_LONG, SITE_TITLE } from '../consts';
import { publishedPosts } from '../lib/posts';

// 首页只列最近 5 篇，全部文章走 /posts.html
const posts = (await publishedPosts()).slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION_LONG}
		/>
		<style>
			.lead {
				color: rgb(var(--gray));
				margin-bottom: 3em;
			}
			ul.posts {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.posts li {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.4em 0;
			}
			ul.posts .date {
				color: rgb(var(--gray));
				font-size: 0.8em;
				white-space: nowrap;
			}
			ul.posts a {
				text-decoration: none;
			}
			ul.posts a:hover {
				text-decoration: underline;
			}
			.more {
				margin-top: 3em;
				font-size: 0.9em;
			}
			@media (max-width: 720px) {
				ul.posts li {
					flex-direction: column;
					gap: 0.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
			{posts.length > 0 && (
				<section>
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<span class="date"><FormattedDate date={post.data.date} /></span>
								<a href={`/posts/${post.id}.html`}>{post.data.title}</a>
							</li>
						))}
					</ul>
				</section>
			)}
			<p class="more"><a href="/posts.html">{ALL_POSTS}</a></p>
		</main>
		<Footer />
	</body>
</html>
